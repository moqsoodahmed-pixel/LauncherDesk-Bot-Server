# ============================================================
# LauncherDesk WhatsApp Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Application
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/launcherdesk

# JWT Authentication
JWT_SECRET=your_very_long_random_jwt_secret_here_at_least_64_chars
JWT_EXPIRES_IN=7d

# ============================================================
# MSG91 WhatsApp Configuration
# Get these values from your MSG91 dashboard:
#   https://control.msg91.com/
# ============================================================

# Your MSG91 authentication key (found under API Keys in the dashboard)
MSG91_AUTH_KEY=your_msg91_auth_key_here

# Your registered WhatsApp sender number (with country code, no +)
# Example: 919876543210
MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX

# Integration ID from MSG91 WhatsApp channel settings
MSG91_INTEGRATION_ID=your_integration_id_here

# Template namespace (from MSG91 WhatsApp template settings)
MSG91_NAMESPACE=your_namespace_here

# Webhook secret for validating incoming MSG91 webhook requests
# Set this in MSG91 dashboard webhook settings too
MSG91_WEBHOOK_SECRET=your_webhook_secret_here

# MSG91 API base URL (usually does not change)
MSG91_BASE_URL=https://api.msg91.com/api/v5

# ============================================================
# Optional AI Service Matching
# Remove or leave blank to disable AI-powered service matching
# ============================================================

# AI provider: 'openai' | 'anthropic' | '' (disabled)
AI_PROVIDER=

# API key for the chosen AI provider
AI_API_KEY=

# Minimum confidence score (0.0–1.0) to auto-route via AI
AI_CONFIDENCE_THRESHOLD=0.80

# ============================================================
# Default Admin Credentials (used during seeding only)
# Change these after first login!
# ============================================================
ADMIN_EMAIL=admin@launcherdesk.com
ADMIN_PASSWORD=Admin@123456

# ============================================================
# Session / Inactivity settings (in minutes)
# ============================================================
INACTIVITY_REMINDER_MINUTES=10
SESSION_ABANDON_HOURS=24
